<title>NST Nowa Ruda – Noworudzka Szkoła Techniczna</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --navy:       #2d3e50;
    --navy-deep:  #1e2d3d;
    --navy-light: #3a5068;
    --steel:      #4a7fa5;
    --steel-light:#6099be;
    --steel-pale: #d0e8f5;
    --accent:     #e8a020;
    --red:        #c0392b;
    --red-dark:   #a93226;
    --white:      #f4f8fb;
    --gray-light: #e8eef4;
    --gray-mid:   #b0bec8;
    --gray-text:  #5a6a7a;
    --text:       #1e2d3d;
  }
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; }
  body { font-family: 'Inter', sans-serif; color: var(--text); background: var(--white); line-height: 1.6; font-size: 16px; }

  /* ─── TOPBAR ─── */
  .topbar { background: var(--navy-deep); color: rgba(255,255,255,0.65); font-size: 0.76rem; padding: 6px 0; }
  .topbar-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
  .topbar a { color: rgba(255,255,255,0.65); text-decoration: none; transition: color .2s; }
  .topbar a:hover { color: var(--accent); }
  .topbar-links { display: flex; gap: 18px; }

  /* ─── HEADER ─── */
  header { background: #fff; border-bottom: 3px solid var(--steel); position: sticky; top: 0; z-index: 100; box-shadow: 0 2px 14px rgba(45,62,80,.1); }
  .header-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; gap: 16px; height: 72px; position: relative; }

  .logo { display: flex; align-items: center; gap: 12px; text-decoration: none; flex-shrink: 0; }
  .logo img { width: 52px; height: 52px; object-fit: contain; border-radius: 6px; }
  .logo-text strong { display: block; font-family: 'Oswald', sans-serif; font-size: 1.1rem; color: var(--navy); font-weight: 700; line-height: 1.2; }
  .logo-text small { font-size: 0.7rem; color: var(--gray-text); }

  nav { display: flex; gap: 2px; align-items: center; }
  nav a { font-size: 0.82rem; font-weight: 500; color: var(--navy); text-decoration: none; padding: 8px 11px; border-radius: 5px; transition: background .15s, color .15s; white-space: nowrap; }
  nav a:hover { background: var(--gray-light); color: var(--steel); }
  nav a.active { color: var(--steel); font-weight: 600; }
  .nav-cta { background: var(--steel) !important; color: #fff !important; border-radius: 6px !important; padding: 8px 16px !important; font-weight: 600 !important; }
  .nav-cta:hover { background: var(--navy-light) !important; }

  .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; padding: 8px; border: none; background: none; }
  .hamburger span { display: block; width: 24px; height: 2px; background: var(--navy); transition: all .3s; }
  .mobile-menu { display: none; position: absolute; top: 100%; left: 0; right: 0; background: #fff; border-top: 1px solid var(--gray-light); box-shadow: 0 8px 24px rgba(0,0,0,.1); padding: 12px 24px 20px; z-index: 99; flex-direction: column; gap: 4px; }
  .mobile-menu.open { display: flex; }
  .mobile-menu a { font-size: .9rem; font-weight: 500; color: var(--navy); text-decoration: none; padding: 10px 8px; border-bottom: 1px solid var(--gray-light); }

  /* ─── HERO ─── */
  .hero { background: var(--navy); min-height: 560px; display: flex; align-items: center; position: relative; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; background: linear-gradient(140deg, var(--navy-deep) 0%, var(--navy) 45%, var(--navy-light) 100%); }

  /* gear decoration */
  .gear-deco { position: absolute; right: -80px; top: -80px; width: 520px; height: 520px; opacity: .06; }
  .gear-deco2 { position: absolute; right: 300px; bottom: -120px; width: 320px; height: 320px; opacity: .05; }

  .hero-inner { position: relative; z-index: 1; max-width: 1200px; margin: 0 auto; padding: 64px 24px; display: grid; grid-template-columns: 1fr 340px; gap: 48px; align-items: center; }
  .hero-label { font-size: .7rem; letter-spacing: 3px; text-transform: uppercase; color: var(--accent); font-weight: 600; margin-bottom: 14px; }
  .hero h1 { font-family: 'Oswald', sans-serif; font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 700; color: #fff; line-height: 1.1; margin-bottom: 20px; }
  .hero h1 em { color: var(--steel-light); font-style: normal; }
  .hero p { color: rgba(255,255,255,.75); font-size: 1.05rem; line-height: 1.75; margin-bottom: 32px; max-width: 520px; }
  .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn-primary { background: var(--steel); color: #fff; padding: 13px 28px; border-radius: 6px; font-weight: 600; font-size: .9rem; text-decoration: none; transition: background .2s, transform .15s; display: inline-block; }
  .btn-primary:hover { background: var(--steel-light); transform: translateY(-2px); }
  .btn-secondary { background: rgba(255,255,255,.1); color: #fff; padding: 13px 28px; border-radius: 6px; font-weight: 500; font-size: .9rem; text-decoration: none; border: 1px solid rgba(255,255,255,.25); transition: background .2s; display: inline-block; }
  .btn-secondary:hover { background: rgba(255,255,255,.18); }

  /* hero logo card */
  .hero-logo-card { display: flex; flex-direction: column; align-items: center; gap: 20px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); border-radius: 16px; padding: 32px 24px; backdrop-filter: blur(8px); }
  .hero-logo-card img { width: 160px; height: 160px; object-fit: contain; filter: drop-shadow(0 8px 24px rgba(74,127,165,.4)); }
  .hero-logo-card h3 { font-family: 'Oswald', sans-serif; color: #fff; font-size: 1rem; text-align: center; font-weight: 600; letter-spacing: .5px; }
  .hero-logo-card p { color: rgba(255,255,255,.6); font-size: .82rem; text-align: center; line-height: 1.5; }
  .rec-list { width: 100%; list-style: none; }
  .rec-list li { font-size: .8rem; color: rgba(255,255,255,.78); padding: 6px 0; border-bottom: 1px solid rgba(255,255,255,.08); display: flex; align-items: center; gap: 8px; }
  .rec-list li:last-child { border: none; }
  .rec-list li::before { content: '▸'; color: var(--accent); font-size: .6rem; }

  /* ─── STATS ─── */
  .stats-bar { background: var(--steel); padding: 22px 0; }
  .stats-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; justify-content: space-around; gap: 16px; flex-wrap: wrap; }
  .stat-item { text-align: center; color: #fff; }
  .stat-num { font-family: 'Oswald', sans-serif; font-size: 2.1rem; font-weight: 700; line-height: 1; display: block; }
  .stat-lbl { font-size: .75rem; opacity: .88; text-transform: uppercase; letter-spacing: 1px; }

  /* ─── SECTIONS ─── */
  section { padding: 72px 0; }
  .section-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .section-header { text-align: center; margin-bottom: 48px; }
  .eyebrow { font-size: .7rem; font-weight: 600; letter-spacing: 3px; text-transform: uppercase; color: var(--steel); margin-bottom: 10px; display: block; }
  .section-header h2 { font-family: 'Oswald', sans-serif; font-size: clamp(1.8rem, 3.5vw, 2.5rem); font-weight: 700; color: var(--navy); line-height: 1.15; }
  .section-header p { color: var(--gray-text); margin-top: 12px; max-width: 600px; margin-left: auto; margin-right: auto; }

  /* ─── OFFER ─── */
  .offer-section { background: var(--white); }
  .offer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; }
  .offer-card { background: #fff; border-radius: 12px; overflow: hidden; border: 1px solid var(--gray-light); transition: box-shadow .25s, transform .2s; text-decoration: none; display: flex; flex-direction: column; }
  .offer-card:hover { box-shadow: 0 12px 40px rgba(45,62,80,.15); transform: translateY(-4px); }
  .offer-card-head { padding: 22px 24px 16px; border-bottom: 3px solid var(--gray-light); }
  .offer-card-head.tech { border-bottom-color: var(--steel); }
  .offer-card-head.bsz { border-bottom-color: var(--accent); }
  .offer-card-head.docs { border-bottom-color: #27ae60; }
  .offer-type { font-size: .68rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: var(--gray-text); margin-bottom: 6px; }
  .offer-card h3 { font-family: 'Oswald', sans-serif; font-size: 1.3rem; color: var(--navy); font-weight: 700; }
  .offer-card-body { padding: 20px 24px 24px; flex: 1; }
  .offer-duration { display: inline-block; background: var(--gray-light); color: var(--navy); font-size: .73rem; font-weight: 600; padding: 3px 10px; border-radius: 20px; margin-bottom: 14px; }
  .offer-specialties { list-style: none; }
  .offer-specialties li { font-size: .875rem; color: var(--gray-text); padding: 6px 0; border-bottom: 1px solid var(--gray-light); display: flex; align-items: center; gap: 8px; }
  .offer-specialties li:last-child { border-bottom: none; }
  .offer-specialties li::before { content: '▸'; color: var(--steel); font-size: .62rem; }

  /* ─── NEWS ─── */
  .news-section { background: var(--gray-light); }
  .news-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px; }
  .news-card { background: #fff; border-radius: 10px; padding: 24px; border-left: 4px solid var(--navy); transition: box-shadow .2s; }
  .news-card:hover { box-shadow: 0 8px 24px rgba(45,62,80,.1); }
  .news-date { font-size: .73rem; color: var(--gray-text); margin-bottom: 10px; font-weight: 500; }
  .news-card h3 { font-family: 'Oswald', sans-serif; font-size: 1.1rem; color: var(--navy); margin-bottom: 10px; font-weight: 600; line-height: 1.3; }
  .news-card p { font-size: .875rem; color: var(--gray-text); line-height: 1.6; }
  .news-tag { display: inline-block; margin-top: 12px; font-size: .68rem; font-weight: 600; letter-spacing: 1px; text-transform: uppercase; color: var(--steel); }

  /* ─── LINKS ─── */
  .links-section { background: #fff; }
  .links-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 14px; }
  .link-tile { background: var(--gray-light); border-radius: 10px; padding: 20px 14px; text-align: center; text-decoration: none; transition: background .2s, transform .15s; border: 1px solid transparent; }
  .link-tile:hover { background: var(--navy); transform: translateY(-2px); }
  .link-tile:hover .tile-icon { color: var(--accent); }
  .link-tile:hover .tile-label { color: #fff; }
  .tile-icon { font-size: 1.7rem; margin-bottom: 8px; display: block; transition: color .2s; }
  .tile-label { font-size: .76rem; font-weight: 600; color: var(--navy); text-transform: uppercase; letter-spacing: .5px; transition: color .2s; }

  /* ─── PROJECTS ─── */
  .projects-section { background: var(--navy-deep); padding: 64px 0; }
  .projects-section .eyebrow { color: var(--accent); }
  .projects-section .section-header h2 { color: #fff; }
  .projects-section .section-header p { color: rgba(255,255,255,.6); }
  .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; }
  .project-card { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: 10px; padding: 24px; transition: background .2s, border-color .2s; }
  .project-card:hover { background: rgba(74,127,165,.15); border-color: var(--steel); }
  .project-card h3 { font-family: 'Oswald', sans-serif; font-size: 1rem; color: var(--steel-light); font-weight: 600; margin-bottom: 10px; line-height: 1.3; }
  .project-card p { font-size: .85rem; color: rgba(255,255,255,.62); line-height: 1.6; }

  /* ─── CONTACT ─── */
  .contact-section { background: var(--gray-light); }
  .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .contact-block h3 { font-family: 'Oswald', sans-serif; font-size: 1.4rem; color: var(--navy); margin-bottom: 22px; font-weight: 700; }
  .contact-item { display: flex; gap: 14px; margin-bottom: 20px; align-items: flex-start; }
  .contact-icon { width: 40px; height: 40px; background: var(--navy); border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1rem; flex-shrink: 0; color: var(--accent); }
  .contact-item strong { display: block; font-size: .72rem; color: var(--gray-text); text-transform: uppercase; letter-spacing: 1px; }
  .contact-item span, .contact-item a { color: var(--navy); font-weight: 500; text-decoration: none; }
  .contact-item a:hover { color: var(--steel); }
  .map-wrap { background: var(--navy); border-radius: 12px; overflow: hidden; height: 290px; }
  .map-wrap iframe { width: 100%; height: 100%; border: none; }

  /* ─── FOOTER ─── */
  footer { background: #111e2b; color: rgba(255,255,255,.6); padding: 52px 0 24px; }
  .footer-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; margin-bottom: 40px; }
  .footer-brand { display: flex; flex-direction: column; gap: 12px; }
  .footer-brand-logo { display: flex; align-items: center; gap: 12px; }
  .footer-brand-logo img { width: 44px; height: 44px; object-fit: contain; border-radius: 6px; }
  .footer-brand-logo span { font-family: 'Oswald', sans-serif; color: #fff; font-weight: 700; font-size: 1rem; }
  .footer-brand p { font-size: .83rem; line-height: 1.7; }
  .footer-col h4 { color: #fff; font-size: .72rem; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 14px; }
  .footer-col a { display: block; color: rgba(255,255,255,.5); font-size: .8rem; text-decoration: none; padding: 4px 0; transition: color .2s; }
  .footer-col a:hover { color: var(--steel-light); }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,.08); padding-top: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; font-size: .76rem; }
  .footer-bottom a { color: rgba(255,255,255,.38); text-decoration: none; }
  .footer-bottom a:hover { color: #fff; }

  /* ─── COUNTDOWN ─── */
  .countdown-bar { background: var(--accent); padding: 10px 0; }
  .countdown-inner { max-width: 1200px; margin: 0 auto; padding: 0 24px; display: flex; align-items: center; justify-content: center; gap: 20px; flex-wrap: wrap; }
  .countdown-label { font-weight: 700; color: var(--navy-deep); font-size: .88rem; }
  .countdown-timer { display: flex; gap: 6px; }
  .c-unit { background: var(--navy-deep); color: #fff; border-radius: 6px; padding: 4px 12px; text-align: center; }
  .c-num { font-family: 'Oswald', sans-serif; font-size: 1.4rem; font-weight: 700; display: block; line-height: 1; }
  .c-lbl { font-size: .57rem; text-transform: uppercase; letter-spacing: 1px; opacity: .7; }

  /* ─── RESPONSIVE ─── */
  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; }
    .hero-logo-card { display: none; }
    .contact-grid { grid-template-columns: 1fr; }
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 760px) {
    nav { display: none; }
    .hamburger { display: flex; }
    header { position: relative; }
    .footer-grid { grid-template-columns: 1fr; gap: 28px; }
    section { padding: 52px 0; }
  }
  @media (max-width: 480px) {
    .hero-inner { padding: 44px 20px; }
    .hero { min-height: auto; }
  }
</style>
</head>
